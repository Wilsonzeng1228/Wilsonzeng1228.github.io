---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { withBasePath } from '../../config/github-pages.mjs';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { formatArticleDate, getPublishedArticles } from '../../utils/articles.mjs';

export async function getStaticPaths() {
  const articles = getPublishedArticles(await getCollection('blog'));

  return articles.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const articlesUrl = withBasePath(import.meta.env.BASE_URL, 'articles/');
---

<SiteLayout title={post.data.title} description={post.data.description} bodyClass="article-document">
	<main id="main-content" class="article-shell">
		<a class="article-back" href={articlesUrl}>← 返回文章列表</a>
		<header class="article-header">
			<p class="eyebrow">Project log / {post.id}</p>
			<h1>{post.data.title}</h1>
			<p class="article-description">{post.data.description}</p>
			<div class="article-meta">
				<time datetime={post.data.pubDate.toISOString()}>
					发布于 {formatArticleDate(post.data.pubDate)}
				</time>
				{post.data.updatedDate && (
					<time datetime={post.data.updatedDate.toISOString()}>
						更新于 {formatArticleDate(post.data.updatedDate)}
					</time>
				)}
			</div>
			{post.data.tags.length > 0 && (
				<ul class="tag-list article-tags" aria-label="文章标签">
					{post.data.tags.map((tag) => <li class="tag">{tag}</li>)}
				</ul>
			)}
		</header>

		<article class="prose">
			<Content />
		</article>
	</main>
</SiteLayout>
