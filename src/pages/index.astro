---
import { getCollection } from 'astro:content';
import { withBasePath } from '../config/github-pages.mjs';
import { profile } from '../data/profile';
import SiteLayout from '../layouts/SiteLayout.astro';
import { formatArticleDate, getPublishedArticles } from '../utils/articles.mjs';

const emailIsConfigured = !profile.email.startsWith('your-email');
const githubIsConfigured = !profile.github.includes('your-name');
const latestArticles = getPublishedArticles(await getCollection('blog')).slice(0, 3);
const articlesUrl = withBasePath(import.meta.env.BASE_URL, 'articles/');
---

<SiteLayout>
	<main id="main-content" class="shell">
		<section class="hero">
			<p class="eyebrow">{profile.role}</p>
			<h1>{profile.tagline}</h1>
			<p class="hero-copy">{profile.introduction}</p>
			<div class="actions">
				<a class="button primary" href="#projects">查看项目</a>
				<a class="button" href={articlesUrl}>阅读文章</a>
			</div>
		</section>

		<section id="about" class="section">
			<div class="section-heading">
				<h2>关于我</h2>
				<p>{profile.introduction}</p>
			</div>
			<ul class="skills" aria-label="技能列表">
				{profile.skills.map((skill) => <li>{skill}</li>)}
			</ul>
		</section>

		<section id="projects" class="section">
			<div class="section-heading">
				<h2>项目经历</h2>
				<p>这里展示最能代表你的课程设计、嵌入式作品和个人项目。</p>
			</div>
			<div class="projects">
				{profile.projects.map((project) => (
					<article class="project-card">
						<h3>{project.title}</h3>
						<p>{project.description}</p>
						<ul class="tag-list" aria-label={`${project.title}使用的技术`}>
							{project.tags.map((tag) => <li class="tag">{tag}</li>)}
						</ul>
						{project.link && <a class="project-link" href={project.link}>查看详情 →</a>}
					</article>
				))}
			</div>
		</section>

		<section id="articles" class="section">
			<div class="section-heading">
				<h2>最新文章</h2>
				<p>记录项目中的真实问题、判断依据和可复现的解决过程。</p>
			</div>
			<ol class="article-feed article-feed-compact">
				{latestArticles.map((article) => (
					<li>
						<a
							class="article-entry"
							href={withBasePath(import.meta.env.BASE_URL, `articles/${article.id}/`)}
						>
							<time datetime={article.data.pubDate.toISOString()}>
								{formatArticleDate(article.data.pubDate)}
							</time>
							<div class="article-summary">
								<h3>{article.data.title}</h3>
								<p>{article.data.description}</p>
							</div>
							<span class="article-arrow" aria-hidden="true">↗</span>
						</a>
					</li>
				))}
			</ol>
			<a class="text-link" href={articlesUrl}>查看全部文章 →</a>
		</section>

		<section id="contact" class="section">
			<div class="section-heading">
				<h2>保持联系</h2>
				<p>如果你对我的项目、学习方向或合作想法感兴趣，欢迎联系。</p>
			</div>
			<div class="contact-list">
				<span>{profile.location}</span>
				{emailIsConfigured ? <a href={`mailto:${profile.email}`}>{profile.email}</a> : <span>{profile.email}</span>}
				{githubIsConfigured ? <a href={profile.github}>GitHub</a> : <span>{profile.github}</span>}
			</div>
		</section>
	</main>
</SiteLayout>
