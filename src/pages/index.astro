---
import { profile } from '../data/profile';
import { withBasePath } from '../config/github-pages.mjs';
import '../styles/global.css';

const year = new Date().getFullYear();
const emailIsConfigured = !profile.email.startsWith('your-email');
const githubIsConfigured = !profile.github.includes('your-name');
const homeUrl = withBasePath(import.meta.env.BASE_URL);
const faviconSvgUrl = withBasePath(import.meta.env.BASE_URL, 'favicon.svg');
const faviconIcoUrl = withBasePath(import.meta.env.BASE_URL, 'favicon.ico');
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={faviconSvgUrl} />
		<link rel="icon" href={faviconIcoUrl} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={`${profile.name}的个人网站与项目作品集`} />
		<title>{profile.name} · 个人网站</title>
	</head>
	<body>
		<header class="site-header">
			<nav class="shell nav" aria-label="主导航">
				<a class="brand" href={homeUrl}>{profile.name}</a>
				<div class="nav-links">
					<a href="#about">关于</a>
					<a href="#projects">项目</a>
					<a href="#contact">联系</a>
				</div>
			</nav>
		</header>

		<main class="shell">
			<section class="hero">
				<p class="eyebrow">{profile.role}</p>
				<h1>{profile.tagline}</h1>
				<p class="hero-copy">{profile.introduction}</p>
				<div class="actions">
					<a class="button primary" href="#projects">查看项目</a>
					<a class="button" href="#contact">联系我</a>
				</div>
			</section>

			<section id="about" class="section">
				<div class="section-heading">
					<h2>关于我</h2>
					<p>{profile.introduction}</p>
				</div>
				<ul class="skills" aria-label="技能列表">
					{profile.skills.map((skill) => <li>{skill}</li>)}
				</ul>
			</section>

			<section id="projects" class="section">
				<div class="section-heading">
					<h2>项目经历</h2>
					<p>这里展示最能代表你的课程设计、嵌入式作品和个人项目。</p>
				</div>
				<div class="projects">
					{profile.projects.map((project) => (
						<article class="project-card">
							<h3>{project.title}</h3>
							<p>{project.description}</p>
							<ul class="tag-list" aria-label={`${project.title}使用的技术`}>
								{project.tags.map((tag) => <li class="tag">{tag}</li>)}
							</ul>
							{project.link && <a class="project-link" href={project.link}>查看详情 →</a>}
						</article>
					))}
				</div>
			</section>

			<section id="contact" class="section">
				<div class="section-heading">
					<h2>保持联系</h2>
					<p>如果你对我的项目、学习方向或合作想法感兴趣，欢迎联系。</p>
				</div>
				<div class="contact-list">
					<span>{profile.location}</span>
					{emailIsConfigured ? <a href={`mailto:${profile.email}`}>{profile.email}</a> : <span>{profile.email}</span>}
					{githubIsConfigured ? <a href={profile.github}>GitHub</a> : <span>{profile.github}</span>}
				</div>
			</section>
		</main>

		<footer class="shell site-footer">© {year} {profile.name} · Built with Astro</footer>
	</body>
</html>
